{
  "name": "astro-romana-tools",
  "version": "1.10.14",
  "private": true,
  "description": "Tooling for the astro-romana game: procedural low-poly avatar, rocket-part, planet and Mars terrain generators, data-driven audio generator and their validators.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "models:build": "node tools/modeling/build-avatars.mjs",
    "models:build:portraits": "node tools/modeling/portraits/render-reference.mjs && node tools/modeling/build-portraits.mjs",
    "models:build:parts": "node tools/modeling/build-parts.mjs",
    "models:build:bodies": "node tools/modeling/build-bodies.mjs",
    "models:fetch:bodies": "node tools/modeling/fetch-bodies.mjs",
    "models:validate": "node tools/modeling/validate.mjs",
    "models": "npm run models:build && npm run models:build:portraits && npm run models:build:parts && npm run models:build:bodies && npm run models:validate && npm run web:models",
    "web:models": "node tools/web/bundle-models.mjs",
    "web:sites": "node tools/web/site-photos.mjs",
    "web:audit:mobile": "node tools/web/mobile-audit.mjs",
    "web:smoke": "node tools/web/mobile-audit.mjs --smoke",
    "web:clips": "node tools/web/minigame-clips.mjs",
    "lint": "eslint .",
    "check:imports": "node tools/check-imports.mjs",
    "check": "npm run lint && npm run check:imports && npm run version:check && npm run i18n:check",
    "i18n:check": "node tools/web/check-i18n.mjs",
    "i18n:audit": "node tools/web/i18n-audit.mjs",
    "prepare": "node tools/version.mjs --install-hook",
    "version:check": "node tools/version.mjs --check",
    "version:bump": "node tools/version.mjs",
    "version:bump:server": "node tools/version.mjs --server",
    "server:status": "node tools/server-admin.mjs status",
    "server:restart": "node tools/server-admin.mjs restart",
    "terrain:build": "node tools/terrain/build-terrain.mjs",
    "terrain:fetch": "node tools/terrain/build-terrain.mjs --fetch",
    "terrain:validate": "node tools/terrain/validate-terrain.mjs",
    "terrain": "npm run terrain:build && npm run terrain:validate",
    "audio:fetch": "node tools/audio/fetch-rad.mjs",
    "audio:build": "node tools/audio/generate.mjs",
    "audio:validate": "node tools/audio/validate.mjs",
    "audio": "npm run audio:build && npm run audio:validate"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "geotiff": "3.0.5",
    "globals": "17.14.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "0.186.1"
  }
}
