# Copy this file to .env (git ignores .env) to use npm run server:status and npm run server:restart.

# The room server's address. Empty: the v2 VM, taken from NET_SERVER in web/net.js.
ASTRO_SERVER_URL=

# The VM's admin token: the value after ADMIN_TOKEN= in /etc/astro-romana-v2/admin.env
# (setup-v2.sh creates it and prints it once; later: sudo cat /etc/astro-romana-v2/admin.env).
ASTRO_ADMIN_TOKEN=
